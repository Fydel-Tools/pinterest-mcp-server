# Pinterest MCP server environment variables. Copy to .env and fill in.
# Never commit real values.

# --- Pinterest app (app id 1517658) ---
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Token file. Local default: ~/pinterest_mcp/auth/tokens.json. Railway: /data/tokens.json (volume).
PINTEREST_TOKEN_PATH=
# API base. Default: https://api.pinterest.com/v5 (production). Never switched automatically.
PINTEREST_API_BASE=

# --- Hosted Pinterest account OAuth (/pinterest/connect, /pinterest/callback) ---
# Must exactly match a redirect URI registered in the Pinterest app.
# Production: https://pinterest.meminent.ai/pinterest/callback
PINTEREST_REDIRECT_URI=
# HTTP Basic auth password guarding /pinterest/connect (any username).
PINTEREST_CONNECT_PASSWORD=

# --- Remote HTTP entrypoint: WorkOS AuthKit OAuth (connector auth) ---
# Shared AuthKit domain (same as brain-v2, faire, amazon-sp).
AUTHKIT_DOMAIN=
# This server's public MCP URL. Must exactly match the resource registered in
# WorkOS AuthKit so token `aud` lines up. Production: https://pinterest.meminent.ai/mcp
MCP_RESOURCE_URL=
# Comma-separated WorkOS user ids (token `sub`) allowed to connect.
ALLOWED_WORKOS_SUBS=

# Port the HTTP server listens on. Railway sets this automatically. Default 8080.
PORT=
# Max POST /mcp body in bytes. Default 1048576.
MAX_PAYLOAD_BYTES=
