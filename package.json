{
  "name": "pinterest-mcp-server",
  "version": "1.1.0",
  "description": "MCP server for Pinterest API v5: pins, boards, analytics, search, and media uploads via stdio or remote Streamable-HTTP (WorkOS AuthKit OAuth) transport",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pinterest-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "auth": "npx tsx src/auth/oauth.ts",
    "start:http": "node dist/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^4.18.2",
    "jose": "^6.2.18",
    "open": "^10.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0"
  }
}
